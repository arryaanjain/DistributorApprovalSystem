# =============================================================================
# Kresconet Distributor Credit Platform — API Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development          # development | staging | production
APP_NAME=Kresconet Distributor Credit Platform
BASE_URL=http://localhost:8080

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/kresconet_dev?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
MIGRATIONS_DIR=./internal/database/migrations

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_BEFORE_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_ME_BEFORE_PRODUCTION
JWT_DISTRIBUTOR_SECRET=CHANGE_ME_BEFORE_PRODUCTION
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY=5m
OTP_MAX_RETRIES=5
OTP_DEV_MODE=true            # true = log OTP instead of sending via API

# ── Redis (for asynq job queue) ───────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Surepass (verification APIs) ─────────────────────────────────────────────
# Obtain token from https://kyc-api.surepass.io
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_CIBIL_BASE_URL=
SUREPASS_TOKEN=YOUR_SUREPASS_TOKEN_HERE
SUREPASS_CIBIL_TOKEN=

# ── Notifications ─────────────────────────────────────────────────────────────
# Set NOTIFY_EMAIL=true and/or NOTIFY_WHATSAPP=true to enable channels.
NOTIFY_EMAIL=false
NOTIFY_WHATSAPP=false

# Email (SMTP — e.g. AWS SES, Postmark, SendGrid SMTP relay)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@kresconet.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=Kresconet <no-reply@kresconet.com>

# WhatsApp (Meta Cloud API)
WA_API_URL=https://graph.facebook.com/v19.0
WA_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WA_PHONE_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID

# ── File Storage (for payment proofs, documents) ─────────────────────────────
# Configure your storage backend (S3-compatible, local, etc.)
DOCUMENT_BUCKET=kresconet-documents

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Razorpay (Payments & Sample Orders) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_kresconet_key
RAZORPAY_KEY_SECRET=rzp_test_kresconet_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# ── Shiprocket (Logistics & Sample Dispatch) ──────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_TOKEN=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=Primary


# ── Admin User Credentials ───────────────────────────────────────────────────
ADMIN_EMAIL=kresconet@gmail.com
ADMIN_PASSWORD=Kresco4572?
